        "occ"
      ],
      "priority": 5,
      "color_space": "Raw",
      "is_color": false
    },
    "arm": {
      "aliases": [
        "arm"
      ],
      "priority": 5,
      "color_space": "Raw",
      "is_color": false,
      "is_combo": true,
      "channels": {
        "r": "ao",
        "g": "roughness",
        "b": "metallic"
      }
    },
    "orm": {
      "aliases": [
        "orm"
      ],
      "priority": 5,
      "color_space": "Raw",
      "is_color": false,
      "is_combo": true,
      "channels": {
        "r": "ao",
        "g": "roughness",
        "b": "metallic"
      }
    },
    "emissive": {
      "aliases": [
        "emit",
        "emission",
        "illumination",
        "emissive_map",
        "glow"
      ],
      "priority": 6,
